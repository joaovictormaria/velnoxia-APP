// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum AdminRole {
  OWNER
  MANAGER
  /// Entregador. Conta criada pelo dono, nunca por autocadastro.
  COURIER
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum CategoryKind {
  PIZZA
  SIMPLE
}

enum HalfPizzaPricingRule {
  HIGHEST_PRICE
  AVERAGE_PRICE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Como o benefício do funcionário se aplica a um item.
///
/// NONE existe para poder dizer "aqui não tem desconto" numa exceção sem
/// apagá-la: é assim que "50% em lanches, nada em bebidas" se escreve.
enum EmployeeBenefitType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
  /// Preço de funcionário: o item passa a custar este valor, e nunca mais caro
  /// do que já custava.
  FIXED_PRICE
}

/// Como a cota diária é contada. O dono escolhe uma; as outras ficam sem efeito.
enum EmployeeLimitMode {
  NONE
  ITEMS_PER_DAY
  AMOUNT_PER_DAY
  /// O limite mora em cada exceção (`EmployeeBenefitRule.dailyLimit`), e não no
  /// plano: "1 lanche e 2 bebidas" são dois números diferentes.
  PER_CATEGORY
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  /// Desconto em folha. Fica de fora de `acceptedPaymentMethods` de propósito:
  /// não é uma forma de pagamento da loja, é um acerto com o funcionário, e só
  /// aparece no checkout de quem foi reconhecido por um plano que a permite.
  PAYROLL
}

enum PaymentStatus {
  PENDING
  PAID
}

enum OrderSource {
  SITE
  WHATSAPP
  PHONE
  ADMIN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum StatusAuthorType {
  ADMIN
  SYSTEM
  CUSTOMER
  /// O entregador marcando a propria entrega como concluida.
  COURIER
}

enum ReviewChannel {
  GOOGLE
  WHATSAPP
  SITE
  OTHER
}

enum ReviewStatus {
  PENDING
  RESPONDED
}

enum NotificationType {
  NEW_ORDER
  ORDER_CANCELLED
  NEW_REVIEW
}

// ---------- Tenant ----------

enum StoreStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

/// Tenant root. Every customer-facing and admin-facing record hangs off a
/// Store, and every query must be scoped by storeId — there is no global view.
model Store {
  id           String      @id @default(cuid())
  /// Drives the starter catalog and the storefront copy (pizzaria, hamburgueria...).
  businessType String      @default("pizzaria")
  /// Public URL segment: velnox.app/<slug>. Checked against RESERVED_SLUGS on
  /// signup so a store can never shadow a real route (/admin, /criar-site...).
  slug         String      @unique
  name         String
  status       StoreStatus @default(TRIAL)
  trialEndsAt  DateTime?

  /// O cliente no Stripe. Criado na primeira tentativa de assinar e reusado
  /// depois, para o dono não virar dois clientes com dois cartões.
  stripeCustomerId     String?   @unique
  /// A assinatura corrente. Null enquanto ele nunca assinou.
  stripeSubscriptionId String?   @unique
  /// O texto cru que o Stripe usa ("active", "past_due", "canceled"). Guardado
  /// para a tela explicar o porquê em vez de só dizer que caiu.
  subscriptionStatus   String?
  /// Até quando o acesso está pago. Null numa loja liberada na mão, que então
  /// não expira. É esta data, e não o status, que decide o corte.
  paidUntil            DateTime?
  /// Marcada quando o dono pede cancelamento: ele continua usando até o fim
  /// do período que já pagou, e a tela precisa dizer isso.
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings             StoreSettings?
  admins               AdminUser[]
  categories           Category[]
  products             Product[]
  extras               Extra[]
  coupons              Coupon[]
  customers            Customer[]
  orders               Order[]
  reviews              Review[]
  posts                Post[]
  courierInvites       CourierInvite[]
  promotions           Promotion[]
  notifications        Notification[]
  employees            Employee[]
  employeeBenefitPlans EmployeeBenefitPlan[]
  inventoryItems       InventoryItem[]       @relation("InventoryItems")
  inventoryMovements   InventoryMovement[]   @relation("InventoryMovements")
  productCompositions  ProductComposition[]  @relation("ProductCompositions")
  tables               Table[]
  tableSessions        TableSession[]

  @@index([status])
}

// ---------- Mesas QRCode ----------

/// Sessão temporária do cliente ao escanear QRCode da mesa.
/// Auto-expira após 24h, nunca cresce muito porque é limpeza regular.
model TableSession {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableId   String   @unique
  tableNumber Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([storeId, expiresAt])
}

// ---------- Auth ----------

model AdminUser {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  /// Globally unique: the login form finds the user by e-mail alone, and the
  /// store comes from the user record rather than being typed in.
  email          String           @unique
  passwordHash   String
  role           AdminRole        @default(OWNER)
  deliveries     Order[]          @relation("OrderCourier")
  /// Onde ele está agora — só a última posição, e só enquanto tem entrega.
  location       CourierLocation?
  isActive       Boolean          @default(true)
  /// Sobe a cada troca de senha ou desativação. A sessão guarda a versão que
  /// tinha no login; quando divergem, o cookie antigo deixa de valer. É o que
  /// faz uma redefinição de senha expulsar quem já estava dentro.
  sessionVersion Int              @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  respondedReviews Review[]             @relation("ReviewRespondedBy")
  passwordResets   PasswordResetToken[]

  @@index([storeId])
}

// ---------- Configuração da loja ----------

model StoreSettings {
  id                       String          @id @default(cuid())
  storeId                  String          @unique
  store                    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeName                String          @default("Bella Pizza")
  /// Short label under the store name in the header (e.g. "Pizzaria").
  tagline                  String?
  heroSubtitle             String?
  aboutEyebrow             String?
  aboutTitle               String?
  aboutBody                String?
  aboutImageUrl            String?
  /// Longer paragraph shown in the storefront footer.
  description              String?
  logoUrl                  String?
  primaryColor             String          @default("#E11D2E")
  /// SOLID uses primaryColor flat; GRADIENT blends the three stops.
  colorMode                String          @default("GRADIENT")
  secondaryColor           String?
  tertiaryColor            String?
  whatsappNumber           String
  email                    String?
  instagramUrl             String?
  facebookUrl              String?
  tiktokUrl                String?
  addressStreet            String?
  addressNumber            String?
  addressComplement        String?
  addressNeighborhood      String?
  addressCity              String?
  addressState             String?
  addressZipCode           String?
  deliveryFee              Float           @default(6)
  freeDeliveryMinOrder     Float?
  minOrderValue            Float           @default(0)
  estimatedDeliveryMinMin  Int             @default(35)
  estimatedDeliveryMinMax  Int             @default(55)
  estimatedPickupMinMin    Int             @default(15)
  estimatedPickupMinMax    Int             @default(25)
  acceptsDelivery          Boolean         @default(true)
  acceptsPickup            Boolean         @default(true)
  acceptedPaymentMethods   PaymentMethod[] @default([PIX, CREDIT_CARD, DEBIT_CARD, CASH])
  autoPrintEnabled         Boolean         @default(false)
  whatsappNotifyEnabled    Boolean         @default(true)
  notificationSoundEnabled Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  openingHours     OpeningHour[]
  restaurantPhotos RestaurantPhoto[]
}

model OpeningHour {
  id              String        @id @default(cuid())
  storeSettingsId String
  storeSettings   StoreSettings @relation(fields: [storeSettingsId], references: [id], onDelete: Cascade)
  weekday         Weekday
  isOpen          Boolean       @default(true)
  opensAt         String        @default("18:00")
  closesAt        String        @default("23:30")

  @@unique([storeSettingsId, weekday])
}

model RestaurantPhoto {
  id              String        @id @default(cuid())
  storeSettingsId String
  storeSettings   StoreSettings @relation(fields: [storeSettingsId], references: [id], onDelete: Cascade)
  url             String
  caption         String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
}

// ---------- Cardápio ----------

model Category {
  id        String       @id @default(cuid())
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  /// Small pill above the category title on the storefront.
  badge     String?
  /// Two-line blurb under the category title.
  headline  String?
  subhead   String?
  icon      String?
  imageUrl  String?
  kind      CategoryKind @default(SIMPLE)
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products             Product[]
  sizes                CategorySize[]
  optionGroups         OptionGroup[]
  employeeBenefitRules EmployeeBenefitRule[]
  extraScopes          ExtraScope[]

  @@unique([storeId, slug])
  @@index([storeId, sortOrder])
}

model Product {
  id                   String               @id @default(cuid())
  storeId              String
  store                Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String
  categoryId           String
  category             Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Linkagem para estoque: qual InventoryItem este produto usa
  inventoryItemId      String?
  inventoryItem        InventoryItem?       @relation("ProductInventory", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  basePrice            Float
  imageUrl             String?
  tag                  String?
  isActive             Boolean              @default(true)
  allowHalfAndHalf     Boolean              @default(false)
  halfPizzaPricingRule HalfPizzaPricingRule @default(HIGHEST_PRICE)
  sortOrder            Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  sizes                ProductSize[]
  orderItems           OrderItem[]
  optionGroups         OptionGroup[]
  employeeBenefitRules EmployeeBenefitRule[]
  extraScopes          ExtraScope[]
  productCompositions  ProductComposition[]

  @@unique([storeId, slug])
  @@index([categoryId, isActive])
  @@index([storeId, isActive])
  @@index([inventoryItemId])
}

/// Os tamanhos que uma categoria oferece, com o nome que o dono escolher:
/// "Brotinho/Média/Grande/Gigante" numa pizzaria, "P/M/G" numa marmitaria,
/// "300ml/500ml" numa açaiteria.
///
/// Pertencem à categoria, e não ao produto, por causa da meia a meia: o preço
/// de uma pizza metade A metade B procura o mesmo tamanho nos dois sabores. Se
/// cada produto nomeasse os seus, "Grande" e "grande" seriam tamanhos
/// diferentes e a conta sairia errada sem ninguém perceber.
model CategorySize {
  id         String        @id @default(cuid())
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// O que o cliente lê. Livre de propósito — cada ramo chama do seu jeito.
  label      String
  sortOrder  Int           @default(0)
  prices     ProductSize[]

  @@unique([categoryId, label])
  @@index([categoryId, sortOrder])
}

/// Uma escolha que o cliente faz ao pedir: o sabor do shake, o ponto da
/// carne, os complementos do açaí, a borda da pizza.
///
/// Mora na categoria pelo mesmo motivo dos tamanhos: é uma característica do
/// tipo de produto, não de cada item. A categoria "Shakes" pergunta o sabor
/// uma vez, e todos os shakes herdam a pergunta.
///
/// As três regras cobrem o que cada ramo precisa sem inventar um campo por
/// caso: "escolha 1 obrigatório" é min=1/max=1, "até 3 grátis depois paga" é
/// free=3, e o adicional solto de sempre é min=0 sem limite.
/// Uma pergunta feita ao pedir: "Sabor", "Ponto da carne", "Complementos".
///
/// Pertence a uma categoria OU a um produto, nunca aos dois. A da categoria
/// vale para tudo que estiver nela; a do produto vale só para ele. Isso existe
/// porque "Bebidas" tem refrigerante e suco na mesma categoria, e os sabores de
/// um não são os do outro.
model OptionGroup {
  id          String       @id @default(cuid())
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// O que a pergunta diz na tela: "Sabor", "Ponto da carne", "Complementos".
  name        String
  /// Zero deixa a pergunta opcional; 1 ou mais a torna obrigatória.
  minChoices  Int          @default(0)
  /// Quantas opções cabem. 1 vira botão de escolha única na vitrine.
  maxChoices  Int          @default(1)
  /// Quantas escolhas não são cobradas, contando da primeira.
  freeChoices Int          @default(0)
  sortOrder   Int          @default(0)
  options     OptionItem[]

  @@index([categoryId, sortOrder])
  @@index([productId, sortOrder])
}

/// Uma opção dentro do grupo, com o preço que ela acrescenta.
model OptionItem {
  id          String      @id @default(cuid())
  groupId     String
  group       OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  /// Acréscimo. Zero nas escolhas que não custam, como o sabor.
  price       Float       @default(0)
  isAvailable Boolean     @default(true)
  sortOrder   Int         @default(0)

  chosen OrderItemExtra[]

  @@unique([groupId, name])
  @@index([groupId, sortOrder])
}

/// Quanto um produto custa em cada tamanho da categoria dele.
model ProductSize {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  categorySizeId String
  categorySize   CategorySize @relation(fields: [categorySizeId], references: [id], onDelete: Cascade)
  price          Float
  isAvailable    Boolean      @default(true)

  @@unique([productId, categorySizeId])
  @@index([categorySizeId])
}

model Extra {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItemExtras OrderItemExtra[]
  /// Onde ele pode ser pedido. Sem nenhum alcance, não aparece em lugar algum.
  scopes          ExtraScope[]

  @@index([storeId, isActive])
}

/**
 * Onde um adicional pode ser pedido: numa categoria inteira ou num produto —
 * nunca nos dois na mesma linha, como nos `OptionGroup`.
 * Antes disto o adicional era da loja e valia para tudo: dava para pedir borda
 * de catupiry num refrigerante, e o sistema aceitava e cobrava. O dono não
 * tinha onde dizer que não.
 * A categoria existe porque sem ela o cadastro seria impraticável: numa
 * pizzaria de quarenta sabores, "Borda de catupiry" exigiria quarenta marcações
 * e mais uma a cada pizza nova — e a que fosse esquecida viraria uma borda que
 * some da vitrine sem ninguém entender. Marcando a categoria, produto novo já
 * nasce oferecendo o que os irmãos oferecem.
 */
model ExtraScope {
  id         String    @id @default(cuid())
  extraId    String
  extra      Extra     @relation(fields: [extraId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Um alcance por alvo: duas linhas iguais só ofereceriam o mesmo duas vezes.
  @@unique([extraId, categoryId])
  @@unique([extraId, productId])
  @@index([categoryId])
  @@index([productId])
}

model Coupon {
  id            String       @id @default(cuid())
  storeId       String
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String
  description   String?
  discountType  DiscountType
  discountValue Float
  minOrderValue Float?
  maxUsage      Int?
  usageCount    Int          @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders Order[]

  @@unique([storeId, code])
}

/// Slides of the storefront "Oferta da semana" carousel. Free text rather than
/// a link to a product: most of these are combos and weekday deals that do not
/// exist as a single catalog item.
model Promotion {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Small line above the title ("Oferta da semana", "Toda sexta-feira").
  eyebrow       String
  title         String
  description   String
  /// Shown as a badge; free text so "-20%" and "Leve 3 pague 2" both fit.
  discount      String?
  price         Float?
  originalPrice Float?
  imageUrl      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId, isActive, sortOrder])
}

// ---------- Clientes ----------

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  /// Unique per store, not globally: the same person can order from several
  /// lanchonetes and each keeps its own customer record and history.
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  reviews Review[]

  @@unique([storeId, phone])
}

// ---------- Funcionários ----------

/**
 * Quem trabalha na loja e come nela.
 * Não é um `AdminUser`: o funcionário não entra no painel, não tem senha e não
 * vê pedido nenhum. Ele pede pela vitrine como qualquer cliente, e o que o
 * distingue é ser reconhecido no checkout. Por isso ele também continua tendo
 * um `Customer` normal — o histórico dele como comprador é o de todo mundo.
 * O reconhecimento é telefone + PIN. Só o telefone não bastaria: quem soubesse
 * o número de um colega comeria com o desconto dele, e a conta só apareceria
 * errada no fim do mês.
 */
model Employee {
  id        String               @id @default(cuid())
  storeId   String
  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  /// A função, livre: "cozinha", "atendimento", "caixa". Só para o dono se
  /// achar na lista — quem manda no desconto é o plano.
  jobTitle  String?
  /// Só dígitos, no mesmo formato em que o checkout grava `customerPhone`. É a
  /// chave do reconhecimento, e por isso é única dentro da loja.
  phone     String
  /// Guardado como hash, igual às senhas. Um PIN de 4 dígitos em texto puro no
  /// banco é a mesma coisa que não ter PIN.
  pinHash   String
  /// Sem plano, o funcionário fica cadastrado mas não ganha nada — é o estado
  /// de quem acabou de ser contratado e ainda não teve o benefício definido.
  planId    String?
  plan      EmployeeBenefitPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  orders Order[]

  @@unique([storeId, phone])
  @@index([storeId, isActive])
}

/**
 * O benefício de um grupo de funcionários: "Cozinha", "Atendimento".
 * Mora num plano, e não em cada pessoa, porque a regra quase sempre é do cargo
 * e não do indivíduo — mudar o desconto da cozinha teria de ser reescrito em
 * cada ficha, e bastaria esquecer uma.
 * A regra padrão vale para o cardápio inteiro; as exceções em
 * `EmployeeBenefitRule` cobrem categoria e produto. São os dois juntos que
 * fazem os quatro jeitos que o dono pediu caberem num mecanismo só: só o
 * padrão é "% em tudo"; padrão NONE mais exceções por categoria é "% por
 * categoria"; padrão NONE mais exceções por produto é "só nos marcados"; e
 * exceções FIXED_PRICE são o preço de funcionário.
 */
model EmployeeBenefitPlan {
  id           String              @id @default(cuid())
  storeId      String
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  defaultType  EmployeeBenefitType @default(NONE)
  defaultValue Float               @default(0)
  limitMode    EmployeeLimitMode   @default(NONE)
  /// Itens por dia ou reais por dia, conforme o modo. Ignorado em NONE e em
  /// PER_CATEGORY, onde o número está em cada exceção.
  limitValue   Float?
  /// Libera "desconto em folha" no checkout de quem tem este plano. Sem isto, a
  /// forma de pagamento não é oferecida e o servidor a recusa.
  allowPayroll Boolean             @default(false)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  rules     EmployeeBenefitRule[]
  employees Employee[]

  @@unique([storeId, name])
}

/**
 * Uma exceção à regra padrão do plano, para uma categoria OU para um produto —
 * nunca os dois, como nos `OptionGroup`.
 * A resolução é produto > categoria > padrão: o item procura primeiro uma
 * regra sua, depois uma da categoria dele, e só então cai no padrão do plano.
 */
model EmployeeBenefitRule {
  id         String              @id @default(cuid())
  planId     String
  plan       EmployeeBenefitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       EmployeeBenefitType
  value      Float               @default(0)
  /// Quantas unidades por dia, quando o plano conta a cota por categoria.
  dailyLimit Int?

  @@unique([planId, categoryId])
  @@unique([planId, productId])
  @@index([planId])
}

// ---------- Pedidos ----------

model Order {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Sequential per store, not global — each lanchonete counts its own orders
  /// from #1. Assigned inside the create transaction, so autoincrement (which
  /// is database-wide) cannot be used here.
  number  Int

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String

  /// Segredo do link publico de acompanhamento. Unico e nao adivinhavel: sem
  /// ele, trocar o numero do pedido mostraria o pedido de outra pessoa.
  trackingToken String? @unique

  /// Quem leva. Opcional: o dono pode sair para entrega sem escolher
  /// ninguem, e o pedido nao pode ficar preso por causa disso.
  courierId           String?
  courier             AdminUser? @relation("OrderCourier", fields: [courierId], references: [id], onDelete: SetNull)
  /// O nome de quem levou, copiado no momento do despacho.
  ///
  /// Apagar a conta do entregador zera courierId — é o SetNull acima, e tem
  /// de ser assim para não impedir a exclusão. Sem esta cópia, todo pedido que
  /// ele entregou passaria a dizer que ninguém levou.
  courierNameSnapshot String?

  /// Quem pediu era funcionário. Reconhecido pelo telefone mais o PIN no
  /// checkout — o funcionário pede pela vitrine como qualquer cliente, e é aqui
  /// que fica registrado que aquele pedido saiu com benefício.
  employeeId           String?
  employee             Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// O nome copiado no momento do pedido, pelo mesmo motivo do
  /// `courierNameSnapshot`: apagar a ficha do funcionário não pode apagar o
  /// registro de quem pegou o quê.
  employeeNameSnapshot String?
  /// Quanto do `discount` veio do benefício. Redundante de propósito: o
  /// relatório de pessoal precisa separar isto de um desconto de cupom, e os
  /// dois moram no mesmo campo de total.
  employeeDiscount     Float     @default(0)
  /// Por qual regra, em português, para a tela do pedido explicar sem recalcular
  /// nada: "Plano Cozinha — 30%; 2 itens fora da cota".
  employeeBenefitNote  String?

  /// Marcado quando a comida ficou pronta e nao havia entregador para levar.
  /// E o que separa "ainda no forno" de "parado esperando alguem": sem isso a
  /// lista de espera seria indistinguivel da coluna de preparo.
  awaitingCourierSince DateTime?

  type   OrderType   @default(DELIVERY)
  status OrderStatus @default(RECEIVED)
  source OrderSource @default(SITE)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  subtotal    Float
  deliveryFee Float @default(0)
  discount    Float @default(0)
  total       Float

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  deliveryStreet       String?
  deliveryNumber       String?
  deliveryComplement   String?
  deliveryNeighborhood String?
  deliveryCity         String?
  deliveryState        String?
  deliveryZipCode      String?

  customerNote String?
  internalNote String?

  /// Mesa onde o pedido foi feito (dine-in). Null para delivery/pickup.
  tableId    String?
  table      Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  /// Label da mesa (ex: "Mesa 1") para exibição. Null se delivery/pickup.
  tableLabel String?

  estimatedDeliveryAt DateTime?
  autoPrintRequested  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reviews       Review[]

  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  /// A tela do entregador so pergunta pelas entregas dele.
  @@index([courierId, status])
  /// A cota do dia é uma pergunta por funcionário dentro de uma janela de
  /// tempo, e ela é feita em todo checkout dele.
  @@index([employeeId, createdAt])
  @@index([storeId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  sizeLabel           String?

  isHalfAndHalf             Boolean @default(false)
  secondProductId           String?
  secondProductNameSnapshot String?

  unitPrice Float
  quantity  Int     @default(1)
  note      String?

  /// Quanto o benefício do funcionário tirou desta linha, no total (já
  /// multiplicado pelas unidades que entraram na cota).
  employeeDiscount Float @default(0)
  /// Quantas unidades desta linha couberam na cota do dia. Menor que
  /// `quantity` quando a cota acabou no meio da linha — é o que permite dizer
  /// "dois com desconto, o terceiro cheio" em vez de tratar a linha inteira
  /// como beneficiada ou não.
  benefitQuantity  Int   @default(0)

  extras OrderItemExtra[]

  @@index([orderId])
}

model OrderItemExtra {
  id                String      @id @default(cuid())
  orderItemId       String
  orderItem         OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  extraId           String?
  extra             Extra?      @relation(fields: [extraId], references: [id], onDelete: SetNull)
  /// Preenchido quando a linha veio de um grupo de opções, e não da lista
  /// solta de adicionais. Os dois convivem na mesma tabela porque, para o
  /// pedido, ambos são "algo que o cliente escolheu e entrou na conta".
  optionItemId      String?
  optionItem        OptionItem? @relation(fields: [optionItemId], references: [id], onDelete: SetNull)
  /// O nome do grupo no momento da compra, para o pedido dizer
  /// "Sabor: Chocolate" e não só "Chocolate".
  groupNameSnapshot String?
  nameSnapshot      String
  priceSnapshot     Float
}

model OrderStatusHistory {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     OrderStatus
  note       String?
  authorType StatusAuthorType @default(SYSTEM)
  authorName String?
  createdAt  DateTime         @default(now())

  @@index([orderId, createdAt])
}

// ---------- Avaliações ----------

model Review {
  id                   String        @id @default(cuid())
  storeId              String
  store                Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNameSnapshot String
  orderId              String?
  order                Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating               Int
  comment              String
  channel              ReviewChannel @default(SITE)
  status               ReviewStatus  @default(PENDING)
  visitorId            String?
  isHidden             Boolean       @default(false)
  likes                ReviewLike[]
  response             String?
  respondedAt          DateTime?
  respondedByAdminId   String?
  respondedBy          AdminUser?    @relation("ReviewRespondedBy", fields: [respondedByAdminId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([storeId, status])
  @@index([storeId, createdAt])
}

// ---------- Notificações ----------

model Notification {
  id              String           @id @default(cuid())
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  message         String
  relatedOrderId  String?
  relatedReviewId String?
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([storeId, isRead, createdAt])
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([reviewId, visitorId])
  @@index([reviewId])
}

model Post {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  body        String
  imageUrl    String?
  isPublished Boolean    @default(true)
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  likes       PostLike[]

  @@index([storeId, publishedAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postId, visitorId])
  @@index([postId])
}

/**
 * Última posição conhecida do entregador, para o cliente saber a que distância
 * o pedido está.
 * Uma linha por entregador, sobrescrita a cada envio: não existe histórico de
 * trajeto. Guardar o caminho de um trabalhador seria dado sensível sem nenhuma
 * pergunta que ele responda — o cliente só quer saber a distância de agora. A
 * linha é apagada quando a última entrega dele termina.
 */
model CourierLocation {
  courierId String    @id
  courier   AdminUser @relation(fields: [courierId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  /// Raio de erro em metros que o aparelho reportou.
  accuracy  Float?
  updatedAt DateTime  @updatedAt
}

/// Convite para um entregador criar a própria conta. O dono gera, entrega o
/// código por fora, e o motoboy o usa uma única vez para definir sua senha.
/// Assim o dono nunca sabe a senha do funcionário, e o entregador não precisa
/// descobrir quais lojas existem: sem código, não há como entrar.
model CourierInvite {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Guardado como hash: quem ler o banco não consegue usar o convite.
  codeHash  String    @unique
  name      String
  expiresAt DateTime
  usedAt    DateTime?
  usedById  String?
  createdAt DateTime  @default(now())

  @@index([storeId, usedAt])
}

/// Pedido de nova senha. O token vai por e-mail e só o hash fica guardado:
/// quem ler o banco não consegue trocar a senha de ninguém. Uso único e vida
/// curta, porque um link de redefinição é, enquanto vale, a própria senha.
model PasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, usedAt])
}

// ---------- Estoque & Produção (Fase 1) ----------

enum InventoryUnitSystem {
  /// Peso: quilograma, grama, miligrama, tonelada
  WEIGHT

  /// Volume: litro, mililitro, decilitro
  VOLUME

  /// Contagem: unidade, dúzia, par
  COUNT

  /// Comprimento: metro, centímetro, milímetro
  LENGTH

  /// Casos especiais futuros
  CUSTOM
}

enum InventoryMovementType {
  /// Entrada de compra de fornecedor
  PURCHASE

  /// Reserva de estoque (pedido recebido)
  /// NÃO é movimento físico: apenas atualiza quantityReserved
  RESERVATION

  /// Consumo efetivo de estoque (pedido em preparação)
  CONSUMPTION

  /// Saída de insumo para produção
  PRODUCTION

  /// Perda, desperdício, produto estragado
  LOSS

  /// Ajuste manual de inventário
  ADJUSTMENT

  /// Devolução de fornecedor
  RETURN

  /// Reversão de movimentação anterior
  REVERSAL
}

/// Unidade de medida (SISTEMA GLOBAL)
/// Não varia por loja. Seed inicial com unidades padrão.
model InventoryUnit {
  id String @id @default(cuid())

  code        String              @unique
  name        String
  system      InventoryUnitSystem
  description String?
  isBuiltIn   Boolean             @default(false)

  createdAt DateTime @default(now())

  items            InventoryItem[]
  conversions      InventoryUnitConversion[] @relation("from")
  conversionsTo    InventoryUnitConversion[] @relation("to")
  movementUnits    InventoryMovement[]
  compositionUnits CompositionItem[]

  @@index([system])
}

/// Conversão entre unidades (ex: 1kg = 1000g)
model InventoryUnitConversion {
  id String @id @default(cuid())

  fromUnitId String
  fromUnit   InventoryUnit @relation("from", fields: [fromUnitId], references: [id], onDelete: Restrict)

  toUnitId String
  toUnit   InventoryUnit @relation("to", fields: [toUnitId], references: [id], onDelete: Restrict)

  conversionFactor Decimal @db.Decimal(15, 6)

  createdAt DateTime @default(now())

  @@unique([fromUnitId, toUnitId])
  @@index([fromUnitId])
  @@index([toUnitId])
}

/// Item de estoque (insumo, produto de revenda, embalagem, produto produzido)
model InventoryItem {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation("InventoryItems", fields: [storeId], references: [id], onDelete: Cascade)

  name     String
  sku      String?
  barcode  String?
  itemType String  @default("INGREDIENT")

  baseUnitId String
  baseUnit   InventoryUnit @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)

  /// Tamanho do conteúdo (ex: 500g em cada pote)
  contentSize Decimal?    @db.Decimal(15, 4)
  /// Unidade do conteúdo (ex: "g", "ml")
  contentUnit String?

  /// ESTADO DERIVADO: Saldo atual em estoque (FONTE DE VERDADE: InventoryMovement)
  quantityOnHand   Decimal @default(0) @db.Decimal(15, 4)
  /// ESTADO DERIVADO: Quantidade reservada para pedidos
  quantityReserved Decimal @default(0) @db.Decimal(15, 4)
  /// Máximo de estoque (para alertas de estoque baixo: alerta em 30%)
  maximumQuantity  Decimal @default(0) @db.Decimal(15, 4)

  cost Decimal? @db.Decimal(10, 2)

  minimumThreshold Decimal? @db.Decimal(15, 4)
  idealQuantity    Decimal? @db.Decimal(15, 4)
  maximumCapacity  Decimal? @db.Decimal(15, 4)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements    InventoryMovement[]
  compositions CompositionItem[]
  products     Product[]          @relation("ProductInventory")

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([storeId, itemType])
  @@index([storeId, isActive])
  @@index([storeId, createdAt])
}

/// Histórico IMUTÁVEL de movimentações de estoque
/// PRINCÍPIO: O saldo é ESTADO DERIVADO das movimentações. Nunca é editada.
model InventoryMovement {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation("InventoryMovements", fields: [storeId], references: [id], onDelete: Cascade)

  /// Chave de idempotência: store#{refType}#{refId}#{movementType}#{itemId}#{idx}
  /// Para REVERSAL: store#REVERSAL#{originalMovementId}
  idempotencyKey String @unique

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  type InventoryMovementType

  quantity Decimal       @db.Decimal(15, 4)
  unitId   String
  unit     InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  reference     String?
  referenceType String?

  /// Para REVERSAL: qual movimentação está sendo revertida
  originalMovementId String?            @unique
  originalMovement   InventoryMovement? @relation("reversal", fields: [originalMovementId], references: [id], onDelete: SetNull)
  reversedBy         InventoryMovement? @relation("reversal")

  /// Qual composição foi usada
  compositionId String?
  composition   ProductComposition? @relation(fields: [compositionId], references: [id], onDelete: SetNull)

  costAtTime Decimal? @db.Decimal(10, 2)
  note       String?

  authorType String?
  authorId   String?
  authorName String?

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([storeId, itemId])
  @@index([storeId, type])
  @@index([reference])
  @@index([compositionId])
  @@index([originalMovementId])
}

/// Receita/Ficha Técnica (VERSIONADA E IMUTÁVEL APÓS USO)
model ProductComposition {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation("ProductCompositions", fields: [storeId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  version  Int     @default(1)
  isActive Boolean @default(true)

  /// FONTE DE VERDADE: quando foi usada primeira vez
  firstUsedAt DateTime?
  /// Auxiliar: cache de uso
  usageCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     CompositionItem[]
  movements InventoryMovement[]

  @@unique([productId, version])
  @@index([productId, isActive])
  @@index([storeId, createdAt])
}

/// Componente de uma composição (insumo necessário)
model CompositionItem {
  id String @id @default(cuid())

  compositionId String
  composition   ProductComposition @relation(fields: [compositionId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  quantity Decimal       @db.Decimal(15, 4)
  unitId   String
  unit     InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([compositionId])
  @@index([inventoryItemId])
}

// ---------- Mesas (Dine-in) ----------

/// Mesa do restaurante para comer no local (dine-in).
/// Cada mesa tem um QRCode único que direciona para /mesa/{id}.
model Table {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// Número da mesa (1, 2, 3...). Deve ser único por store.
  number Int

  /// Capacidade de pessoas que sentam na mesa
  capacity Int

  /// Status atual da mesa (livre, ocupada, reservada, manutenção)
  status TableStatus @default(AVAILABLE)

  /// URL pública do QRCode: https://velnox.app.br/mesa/{id}
  qrcodeUrl String

  /// Dados do QRCode em base64 para exibição/download
  qrcodeData String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  /// Índices para queries comuns
  @@unique([storeId, number])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}
