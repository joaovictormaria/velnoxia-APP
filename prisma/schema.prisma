// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum AdminRole {
  OWNER
  MANAGER
  /// Entregador. Conta criada pelo dono, nunca por autocadastro.
  COURIER
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum CategoryKind {
  PIZZA
  SIMPLE
}

enum SizeLabel {
  BROTINHO
  MEDIA
  GRANDE
  GIGANTE
}

enum HalfPizzaPricingRule {
  HIGHEST_PRICE
  AVERAGE_PRICE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
}

enum OrderSource {
  SITE
  WHATSAPP
  PHONE
  ADMIN
}

enum StatusAuthorType {
  ADMIN
  SYSTEM
  CUSTOMER
  /// O entregador marcando a propria entrega como concluida.
  COURIER
}

enum ReviewChannel {
  GOOGLE
  WHATSAPP
  SITE
  OTHER
}

enum ReviewStatus {
  PENDING
  RESPONDED
}

enum NotificationType {
  NEW_ORDER
  ORDER_CANCELLED
  NEW_REVIEW
}

// ---------- Tenant ----------

enum StoreStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

/// Tenant root. Every customer-facing and admin-facing record hangs off a
/// Store, and every query must be scoped by storeId — there is no global view.
model Store {
  id          String      @id @default(cuid())
  /// Drives the starter catalog and the storefront copy (pizzaria, hamburgueria...).
  businessType String     @default("pizzaria")
  /// Public URL segment: velnox.app/<slug>. Checked against RESERVED_SLUGS on
  /// signup so a store can never shadow a real route (/admin, /criar-site...).
  slug        String      @unique
  name        String
  status      StoreStatus @default(TRIAL)
  trialEndsAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  settings      StoreSettings?
  admins        AdminUser[]
  categories    Category[]
  products      Product[]
  extras        Extra[]
  coupons       Coupon[]
  customers     Customer[]
  orders        Order[]
  reviews       Review[]
  posts                Post[]
  courierInvites       CourierInvite[]
  promotions    Promotion[]
  notifications Notification[]

  @@index([status])
}

// ---------- Auth ----------

model AdminUser {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  /// Globally unique: the login form finds the user by e-mail alone, and the
  /// store comes from the user record rather than being typed in.
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OWNER)
  deliveries   Order[]   @relation("OrderCourier")
  /// Onde ele está agora — só a última posição, e só enquanto tem entrega.
  location     CourierLocation?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  respondedReviews Review[] @relation("ReviewRespondedBy")

  @@index([storeId])
}

// ---------- Configuração da loja ----------

model StoreSettings {
  id                       String          @id @default(cuid())
  storeId                  String          @unique
  store                    Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeName                String          @default("Bella Pizza")
  /// Short label under the store name in the header (e.g. "Pizzaria").
  tagline                  String?
  heroSubtitle             String?
  aboutEyebrow             String?
  aboutTitle               String?
  aboutBody                String?
  aboutImageUrl            String?
  /// Longer paragraph shown in the storefront footer.
  description              String?
  logoUrl                  String?
  primaryColor             String          @default("#E11D2E")
  /// SOLID uses primaryColor flat; GRADIENT blends the three stops.
  colorMode                String          @default("GRADIENT")
  secondaryColor           String?
  tertiaryColor            String?
  whatsappNumber           String
  email                    String?
  instagramUrl             String?
  facebookUrl              String?
  tiktokUrl                String?
  addressStreet            String?
  addressNumber            String?
  addressComplement        String?
  addressNeighborhood      String?
  addressCity              String?
  addressState             String?
  addressZipCode           String?
  deliveryFee              Float           @default(6)
  freeDeliveryMinOrder     Float?
  minOrderValue            Float           @default(0)
  estimatedDeliveryMinMin  Int             @default(35)
  estimatedDeliveryMinMax  Int             @default(55)
  estimatedPickupMinMin    Int             @default(15)
  estimatedPickupMinMax    Int             @default(25)
  acceptsDelivery          Boolean         @default(true)
  acceptsPickup            Boolean         @default(true)
  acceptedPaymentMethods   PaymentMethod[] @default([PIX, CREDIT_CARD, DEBIT_CARD, CASH])
  autoPrintEnabled         Boolean         @default(false)
  whatsappNotifyEnabled    Boolean         @default(true)
  notificationSoundEnabled Boolean         @default(true)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  openingHours     OpeningHour[]
  restaurantPhotos RestaurantPhoto[]
}

model OpeningHour {
  id              String        @id @default(cuid())
  storeSettingsId String
  storeSettings   StoreSettings @relation(fields: [storeSettingsId], references: [id], onDelete: Cascade)
  weekday         Weekday
  isOpen          Boolean       @default(true)
  opensAt         String        @default("18:00")
  closesAt        String        @default("23:30")

  @@unique([storeSettingsId, weekday])
}

model RestaurantPhoto {
  id              String        @id @default(cuid())
  storeSettingsId String
  storeSettings   StoreSettings @relation(fields: [storeSettingsId], references: [id], onDelete: Cascade)
  url             String
  caption         String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
}

// ---------- Cardápio ----------

model Category {
  id        String       @id @default(cuid())
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  /// Small pill above the category title on the storefront.
  badge     String?
  /// Two-line blurb under the category title.
  headline  String?
  subhead   String?
  icon      String?
  imageUrl  String?
  kind      CategoryKind @default(SIMPLE)
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, sortOrder])
}

model Product {
  id                     String               @id @default(cuid())
  storeId                String
  store                  Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String
  description            String
  categoryId             String
  category               Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  basePrice              Float
  imageUrl               String?
  tag                    String?
  isActive               Boolean              @default(true)
  allowHalfAndHalf       Boolean              @default(false)
  halfPizzaPricingRule   HalfPizzaPricingRule @default(HIGHEST_PRICE)
  sortOrder              Int                  @default(0)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  sizes      ProductSize[]
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([categoryId, isActive])
  @@index([storeId, isActive])
}

model ProductSize {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  size        SizeLabel
  price       Float
  isAvailable Boolean   @default(true)

  @@unique([productId, size])
}

model Extra {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItemExtras OrderItemExtra[]

  @@index([storeId, isActive])
}

model Coupon {
  id             String       @id @default(cuid())
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code           String
  description    String?
  discountType   DiscountType
  discountValue  Float
  minOrderValue  Float?
  maxUsage       Int?
  usageCount     Int          @default(0)
  validFrom      DateTime
  validUntil     DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]

  @@unique([storeId, code])
}

/// Slides of the storefront "Oferta da semana" carousel. Free text rather than
/// a link to a product: most of these are combos and weekday deals that do not
/// exist as a single catalog item.
model Promotion {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Small line above the title ("Oferta da semana", "Toda sexta-feira").
  eyebrow       String
  title         String
  description   String
  /// Shown as a badge; free text so "-20%" and "Leve 3 pague 2" both fit.
  discount      String?
  price         Float?
  originalPrice Float?
  imageUrl      String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId, isActive, sortOrder])
}

// ---------- Clientes ----------

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  /// Unique per store, not globally: the same person can order from several
  /// lanchonetes and each keeps its own customer record and history.
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders  Order[]
  reviews Review[]

  @@unique([storeId, phone])
}

// ---------- Pedidos ----------

model Order {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Sequential per store, not global — each lanchonete counts its own orders
  /// from #1. Assigned inside the create transaction, so autoincrement (which
  /// is database-wide) cannot be used here.
  number  Int

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String

  /// Segredo do link publico de acompanhamento. Unico e nao adivinhavel: sem
  /// ele, trocar o numero do pedido mostraria o pedido de outra pessoa.
  trackingToken String? @unique

  /// Quem leva. Opcional: o dono pode sair para entrega sem escolher
  /// ninguem, e o pedido nao pode ficar preso por causa disso.
  courierId     String?
  courier       AdminUser? @relation("OrderCourier", fields: [courierId], references: [id], onDelete: SetNull)

  /// Marcado quando a comida ficou pronta e nao havia entregador para levar.
  /// E o que separa "ainda no forno" de "parado esperando alguem": sem isso a
  /// lista de espera seria indistinguivel da coluna de preparo.
  awaitingCourierSince DateTime?

  type   OrderType     @default(DELIVERY)
  status OrderStatus   @default(RECEIVED)
  source OrderSource   @default(SITE)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  subtotal    Float
  deliveryFee Float @default(0)
  discount    Float @default(0)
  total       Float

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  deliveryStreet       String?
  deliveryNumber       String?
  deliveryComplement   String?
  deliveryNeighborhood String?
  deliveryCity         String?
  deliveryState        String?
  deliveryZipCode      String?

  customerNote String?
  internalNote String?

  estimatedDeliveryAt DateTime?
  autoPrintRequested  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reviews       Review[]

  @@unique([storeId, number])
  @@index([storeId, status, createdAt])
  /// A tela do entregador so pergunta pelas entregas dele.
  @@index([courierId, status])
  @@index([storeId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  sizeLabel           SizeLabel?

  isHalfAndHalf              Boolean @default(false)
  secondProductId             String?
  secondProductNameSnapshot   String?

  unitPrice Float
  quantity  Int    @default(1)
  note      String?

  extras OrderItemExtra[]

  @@index([orderId])
}

model OrderItemExtra {
  id           String    @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  extraId      String?
  extra        Extra?    @relation(fields: [extraId], references: [id], onDelete: SetNull)
  nameSnapshot String
  priceSnapshot Float
}

model OrderStatusHistory {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     OrderStatus
  note       String?
  authorType StatusAuthorType @default(SYSTEM)
  authorName String?
  createdAt  DateTime         @default(now())

  @@index([orderId, createdAt])
}

// ---------- Avaliações ----------

model Review {
  id                  String       @id @default(cuid())
  storeId             String
  store               Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId          String?
  customer            Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNameSnapshot String
  orderId             String?
  order               Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating              Int
  comment             String
  channel             ReviewChannel @default(SITE)
  status              ReviewStatus  @default(PENDING)
  visitorId           String?
  isHidden            Boolean       @default(false)
  likes               ReviewLike[]
  response            String?
  respondedAt         DateTime?
  respondedByAdminId  String?
  respondedBy         AdminUser?   @relation("ReviewRespondedBy", fields: [respondedByAdminId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([storeId, status])
  @@index([storeId, createdAt])
}

// ---------- Notificações ----------

model Notification {
  id              String           @id @default(cuid())
  storeId         String
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  message         String
  relatedOrderId  String?
  relatedReviewId String?
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([storeId, isRead, createdAt])
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([reviewId, visitorId])
  @@index([reviewId])
}

model Post {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  body        String
  imageUrl    String?
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  likes       PostLike[]

  @@index([storeId, publishedAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postId, visitorId])
  @@index([postId])
}

/**
 * Última posição conhecida do entregador, para o cliente saber a que distância
 * o pedido está.
 *
 * Uma linha por entregador, sobrescrita a cada envio: não existe histórico de
 * trajeto. Guardar o caminho de um trabalhador seria dado sensível sem nenhuma
 * pergunta que ele responda — o cliente só quer saber a distância de agora. A
 * linha é apagada quando a última entrega dele termina.
 */
model CourierLocation {
  courierId String    @id
  courier   AdminUser @relation(fields: [courierId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  /// Raio de erro em metros que o aparelho reportou.
  accuracy  Float?
  updatedAt DateTime  @updatedAt
}

/// Convite para um entregador criar a própria conta. O dono gera, entrega o
/// código por fora, e o motoboy o usa uma única vez para definir sua senha.
/// Assim o dono nunca sabe a senha do funcionário, e o entregador não precisa
/// descobrir quais lojas existem: sem código, não há como entrar.
model CourierInvite {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Guardado como hash: quem ler o banco não consegue usar o convite.
  codeHash   String    @unique
  name       String
  expiresAt  DateTime
  usedAt     DateTime?
  usedById   String?
  createdAt  DateTime  @default(now())

  @@index([storeId, usedAt])
}
