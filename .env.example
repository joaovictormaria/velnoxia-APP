# PostgreSQL (Railway: copie a DATABASE_URL do addon Postgres)
DATABASE_URL="postgresql://user:password@host:port/database"


# Endereco publico do app — o que vai no QR Code das mesas e no painel do dono.
# Sem ela, cai na origem em que a pagina esta aberta (util em desenvolvimento).
# ATENCAO: variaveis VITE_ sao gravadas no pacote durante o build, nao lidas em
# tempo de execucao. No Railway ela precisa existir ANTES do build.
VITE_PUBLIC_APP_URL="https://velnox.app.br"

# Sessão do admin — mínimo 32 caracteres
SESSION_SECRET=""

# Admin criado pelo seed
ADMIN_SEED_EMAIL="admin@bellapizza.com"
ADMIN_SEED_PASSWORD=""

# Resend — envio do e-mail de redefinicao de senha.
# Sem elas o link nao sai; o restante do app funciona normalmente.
# MAIL_FROM precisa ser um remetente de dominio verificado no Resend.
RESEND_API_KEY=""
MAIL_FROM="velnox.ia <nao-responda@velnox.app.br>"

# Anthropic — geração de site com IA (/criar-site, /analise)
ANTHROPIC_API_KEY=""

# Cloudflare R2 (upload de imagens — Fase 2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# --- Cobranca (Stripe) ---------------------------------------------------
# Sem estas tres o painel roda normal e a tela de assinatura avisa que a
# cobranca esta desligada -- e o que se quer em desenvolvimento.
#
# STRIPE_PRICE_ID e o Price recorrente mensal criado no painel do Stripe. O
# valor dele manda; PRECO_MENSAL em src/lib/plano.ts e so o que a tela escreve,
# e os dois precisam ser mudados juntos.
#
# STRIPE_WEBHOOK_SECRET vem do endpoint cadastrado apontando para
# https://SEU_DOMINIO/api/stripe-webhook, assinando estes eventos:
#   checkout.session.completed
#   customer.subscription.created / updated / deleted
#   invoice.paid / invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Os dois planos (BASIC e PREMIUM) ------------------------------------
# Os Prices reais, criados a mao no painel do Stripe em 31/08/2026.
#
#   BASIC    R$ 267/mes
#   PREMIUM  R$ 360/mes
#
# Nao sao segredo: um Price ID viaja para o navegador em todo checkout. O
# segredo e a STRIPE_SECRET_KEY, que continua em branco aqui.
#
# SEM RESERVA. Cada plano so e vendido se a variavel dele existir. Faltando,
# o checkout daquele plano e recusado -- de proposito: cair no Price antigo
# cobraria R$ 300 de quem escolheu o Premium de R$ 360, e o erro so apareceria
# na fatura.
#
# O STRIPE_PRICE_ID acima (R$ 300) e LEGADO. Ele nao e BASIC nem PREMIUM:
# continua cobrando quem ja assina, e o webhook o trata como Price
# desconhecido -- Store.plan fica como esta, sem rebaixar ninguem.
STRIPE_PRICE_ID_BASIC=price_1UAdnm2NEaHcviEee6MSMkQW
STRIPE_PRICE_ID_PREMIUM=price_1UAdoY2NEaHcviEeXh6I5jMv
