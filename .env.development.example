# Template do ambiente de DESENVOLVIMENTO. Versionado e sem nenhum segredo.
# Copie para `.env.development` (ignorado pelo git) antes de rodar `npm run dev`.
#
#   cp .env.development.example .env.development
#
# A DATABASE_URL aponta para o mesmo Postgres local dos testes, na porta 5433.
# NUNCA aponte para o Railway: `npm run dev` grava de verdade no banco que
# encontrar, e um cadastro de teste viraria uma loja real. A app recusa iniciar
# se este valor nao for um host local — ver conferirDestino() em
# src/server/db/client.ts.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velnoxia_dev"

# Valores de faz-de-conta: em desenvolvimento nao se fala com o Stripe real.
STRIPE_SECRET_KEY=sk_test_nao_usar_em_producao
STRIPE_PRICE_ID=price_faz_de_conta
STRIPE_WEBHOOK_SECRET=whsec_faz_de_conta

# Qualquer string serve: assina sessoes descartaveis da sua maquina.
SESSION_SECRET=segredo_de_desenvolvimento_sem_valor

NODE_ENV=development

# Os dois planos. O Price antigo (STRIPE_PRICE_ID) nao e nenhum dos dois.
STRIPE_PRICE_ID_BASIC=price_1UAdnm2NEaHcviEee6MSMkQW
STRIPE_PRICE_ID_PREMIUM=price_1UAdoY2NEaHcviEeXh6I5jMv
