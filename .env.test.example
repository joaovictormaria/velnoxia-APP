# Template do ambiente de TESTE. Este arquivo é versionado e não contém segredo
# nenhum — copie para `.env.test` (que é ignorado pelo git) antes de rodar.
#
#   cp .env.test.example .env.test
#
# A DATABASE_URL aponta para o Postgres do docker-compose.test.yml, na porta
# 5433. NUNCA aponte para o banco do Railway: os testes apagam e recriam dados.

DATABASE_URL="postgresql://velnoxia_test:velnoxia_test_local@localhost:5433/velnoxia_test"

# Valores de faz-de-conta. Os testes não fazem chamada real ao Stripe.
STRIPE_SECRET_KEY=sk_test_nao_usar_em_producao
STRIPE_PRICE_ID=price_faz_de_conta
STRIPE_WEBHOOK_SECRET=whsec_faz_de_conta

# Qualquer string serve: em teste ela só assina sessões descartáveis.
SESSION_SECRET=segredo_de_teste_sem_valor

NODE_ENV=test
